# Local dev: left unset on purpose - the Vite dev server proxies /api, /uploads
# and /img straight to BACKEND_URL from Backend/.env (see vite.config.js).
# The production value lives in .env.production (Vite loads that file only
# for `vite build`/`npm run deploy`, on top of this one) - do not set
# VITE_API_BASE_URL here or local dev will call the live backend instead.

# Small version label shown on the customer login page. Bump this on each release.
VITE_APP_VERSION=1.0.1