# Local dev: left unset on purpose - the Vite dev server proxies /api, /uploads
# and /img straight to BACKEND_URL from Backend/.env (see vite.config.js), so
# Local:      leave unset - Vite's dev server proxies to BACKEND_URL from Backend/.env
 Production: VITE_API_BASE_URL=https://backend.chootistoys.com/api

# Small version label shown on the customer login page. Bump this on each release.
VITE_APP_VERSION=1.0.1